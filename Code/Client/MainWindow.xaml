<Window x:Class="UDM10.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDM10 Upload Client" Height="500" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Server IP:"/>
            <TextBox x:Name="TxtServerIp" Text="127.0.0.1" Width="120"/>
            <Label Content="Port:" Margin="10,0,0,0"/>
            <TextBox x:Name="TxtServerPort" Text="9000" Width="60"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                Height="80" AllowDrop="True" Background="White"
                Drop="DropArea_Drop" DragEnter="DropArea_DragEnter">
            <TextBlock Text="Kéo-thả file vào đây, hoặc bấm nút bên dưới"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Button Grid.Row="1" Content="Chọn file..." Width="100" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Click="BtnChooseFile_Click"/>

        <ListView x:Name="FileListView" Grid.Row="2" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tên file" DisplayMemberBinding="{Binding FileName}" Width="150"/>
                    <GridViewColumn Header="Kích thước" DisplayMemberBinding="{Binding FileSizeText}" Width="80"/>
                    <GridViewColumn Header="Trạng thái" DisplayMemberBinding="{Binding Status}" Width="90"/>
                    <GridViewColumn Header="Tiến độ (%)" DisplayMemberBinding="{Binding PercentComplete}" Width="90"/>
                    <GridViewColumn Header="Tốc độ (KB/s)" DisplayMemberBinding="{Binding SpeedKBps}" Width="100"/>
                    <GridViewColumn Header="Thông báo" DisplayMemberBinding="{Binding Message}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>