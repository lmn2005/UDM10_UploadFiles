<Window x:Class="UDM10.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDM10 Upload Client" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Server IP:"/>
            <TextBox x:Name="TxtServerIp" Text="127.0.0.1" Width="120"/>
            <Label Content="Port:" Margin="10,0,0,0"/>
            <TextBox x:Name="TxtServerPort" Text="9000" Width="60"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                Height="80" AllowDrop="True" Background="White"
                Drop="DropArea_Drop" DragEnter="DropArea_DragEnter">
            <TextBlock Text="Kéo-thả file vào đây, hoặc bấm nút bên dưới"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Button Grid.Row="1" Content="Chọn file..." Width="100" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Click="BtnChooseFile_Click"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnUploadSelected" Content="Upload file đã chọn"
                    Width="140" Height="30" Click="BtnUploadSelected_Click"/>
            <TextBlock x:Name="TxtUploadStatus" Text="Chưa upload"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="FileListView" Grid.Row="3" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tên file" DisplayMemberBinding="{Binding FileName}" Width="180"/>
                    <GridViewColumn Header="Đường dẫn" DisplayMemberBinding="{Binding FilePath}" Width="240"/>
                    <GridViewColumn Header="Kích thước" DisplayMemberBinding="{Binding FileSizeText}" Width="90"/>
                    <GridViewColumn Header="Trạng thái" DisplayMemberBinding="{Binding StatusMessage}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
