<Window x:Class="UDM10.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDM10 Upload File" Height="260" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Upload một file qua TCP"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="ChooseFileButton"
                        Width="110"
                        Height="34"
                        Content="Chọn file"
                        Click="ChooseFileButton_Click" />
                <Button x:Name="UploadButton"
                        Width="90"
                        Height="34"
                        Margin="10,0,0,0"
                        Content="Gửi file"
                        IsEnabled="False"
                        Click="UploadButton_Click" />
            </StackPanel>

            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,16,0,0">
                <TextBlock x:Name="SelectedFileTextBlock"
                           Text="Chưa chọn file"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,14,0,0"
                       Text="Chưa gửi file"
                       TextWrapping="Wrap"
                       Foreground="#555555" />
        </StackPanel>
    </Grid>
</Window>
